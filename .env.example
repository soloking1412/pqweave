# RPC endpoints used by the SDK scanner and the web app's /api/scan route.
# Any EVM RPC URL works; each falls back to a public endpoint when unset, but a
# dedicated endpoint is strongly recommended for reliability.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_OPTIMISM=
RPC_URL_POLYGON=
RPC_URL_SEPOLIA=
RPC_URL_BASE_SEPOLIA=

# Contracts deployment (Foundry script/Deploy.s.sol). Never commit a funded key.
# ENTRYPOINT defaults to the canonical ERC-4337 v0.7 EntryPoint when unset.
DEPLOYER_PRIVATE_KEY=
ENTRYPOINT=

# Web app — deployed contract addresses (set in apps/web/.env.local after deploy).
# Identical on every chain thanks to CREATE2. See DEPLOYMENT.md. Until all three
# are set, the migrate flow runs in "preview" mode (scan + keygen work; the
# on-chain sweep is disabled).
NEXT_PUBLIC_VERIFIER_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_BATCH_EXECUTOR_ADDRESS=

# Migration stage label shown in the UI once contracts are set: "testnet"
# (default) or "mainnet". Has no effect in preview mode.
NEXT_PUBLIC_DEPLOYMENT_STAGE=testnet

# Partnership form (/api/partner) — email delivery via Resend (https://resend.com).
# Get a free API key, then set the inbox that should receive inquiries. With the
# default onboarding sender below, Resend only delivers to the address that owns
# the Resend account (fine for testing). To reach any inbox, verify a domain and
# set PARTNER_NOTIFY_FROM to a sender on it, e.g. "PQWeave <partners@pqweave.com>".
RESEND_API_KEY=
PARTNER_NOTIFY_TO=
PARTNER_NOTIFY_FROM=

# Optional: also POST each inquiry to a webhook (Slack/Discord/CRM). Independent
# of email — set either, both, or neither. When neither is set, inquiries are
# only logged server-side (visible in Vercel logs).
PARTNER_WEBHOOK_URL=
