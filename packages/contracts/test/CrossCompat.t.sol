pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {stdJson} from "forge-std/StdJson.sol";
import {LamportMerkleVerifier} from "../src/verifiers/LamportMerkleVerifier.sol";
import {WinternitzMerkleVerifier} from "../src/verifiers/WinternitzMerkleVerifier.sol";

/// @notice Proves the on-chain verifiers accept signatures produced by the
///         TypeScript SDK. The vectors in test/vectors/ are generated by the SDK
///         (see the package's vector generation scripts).
///
///         A hash-based scheme has to agree byte for byte across runtimes — one
///         differing byte in a tweak, a digit order, or a leaf commitment makes
///         every signature invalid, and the failure would only show up on chain.
contract CrossCompatTest is Test {
    using stdJson for string;

    function test_acceptsSdkGeneratedSignature() public {
        string memory json =
            vm.readFile(string.concat(vm.projectRoot(), "/test/vectors/hashsig.json"));
        bytes32 root = json.readBytes32(".root");
        bytes32 message = json.readBytes32(".message");
        bytes memory signature = json.readBytes(".signature");

        LamportMerkleVerifier verifier = new LamportMerkleVerifier();
        assertTrue(verifier.verify(message, abi.encodePacked(root), signature));
    }

    function test_acceptsSdkGeneratedWinternitzSignature() public {
        (bytes32 root, bytes32 message, bytes memory signature) = _winternitzVector();
        WinternitzMerkleVerifier verifier = new WinternitzMerkleVerifier();
        assertTrue(verifier.verify(message, abi.encodePacked(root), signature));
    }

    function test_rejectsWinternitzSignatureOverAnotherMessage() public {
        (bytes32 root,, bytes memory signature) = _winternitzVector();
        WinternitzMerkleVerifier verifier = new WinternitzMerkleVerifier();
        assertFalse(verifier.verify(keccak256("different"), abi.encodePacked(root), signature));
    }

    function test_rejectsWinternitzSignatureAgainstAnotherRoot() public {
        (, bytes32 message, bytes memory signature) = _winternitzVector();
        WinternitzMerkleVerifier verifier = new WinternitzMerkleVerifier();
        assertFalse(verifier.verify(message, abi.encodePacked(keccak256("other")), signature));
    }

    /// @dev The whole point of Winternitz here is that it is far cheaper to get
    ///      on chain than Lamport, so assert that rather than assume it.
    function test_winternitzSignatureIsFarSmallerThanLamport() public view {
        bytes memory lamport = vm.readFile(
                string.concat(vm.projectRoot(), "/test/vectors/hashsig.json")
            ).readBytes(".signature");
        (,, bytes memory winternitz) = _winternitzVector();

        assertLt(winternitz.length, lamport.length / 8);
    }

    function _winternitzVector()
        private
        view
        returns (bytes32 root, bytes32 message, bytes memory signature)
    {
        string memory json =
            vm.readFile(string.concat(vm.projectRoot(), "/test/vectors/winternitz.json"));
        root = json.readBytes32(".root");
        message = json.readBytes32(".message");
        signature = json.readBytes(".signature");
    }
}
